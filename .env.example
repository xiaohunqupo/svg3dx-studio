# Optional defaults for Copilot Runtime (`npm run copilot`).
# Prefer configuring Base URL / API Key / Model in the assistant Settings UI.

# SPA endpoint. Unset → same-origin /api/copilotkit.
# Put a real URL in .env.local (gitignored), not here.
# VITE_COPILOT_RUNTIME_URL=https://<host>/api/copilotkit

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# COPILOT_MODEL=deepseek-chat
# COPILOT_PORT=8200
