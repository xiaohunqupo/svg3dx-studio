{
  "name": "svg3dx-studio",
  "version": "0.1.0",
  "description": "svg3dx Studio — embeddable Vue page library (browse / edit) + demo SPA",
  "private": true,
  "type": "module",
  "main": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "files": [
    "dist-lib",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE-MIT",
    "LICENSE-MulanPSL-2.0"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && node ./scripts/copy-lib-dts.mjs",
    "preview": "vite preview",
    "build:all": "node ./scripts/build-all.mjs",
    "build:all:dev": "node ./scripts/build-all.mjs --dev",
    "build:all:full": "node ./scripts/build-all.mjs --full-core",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "pinia": "^2.2.0",
    "svg3dx-viewer": "*",
    "tdesign-icons-vue-next": "^0.3.0",
    "tdesign-vue-next": "^1.10.0",
    "three": ">=0.160.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lucide/vue": "^1.75.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@svgedit/svgcanvas": "^7.4.2",
    "codemirror": "^6.0.2",
    "pinia": "^2.2.0",
    "prettier": "^3.10.1",
    "svg3dx-viewer": "*",
    "tdesign-icons-vue-next": "^0.3.0",
    "tdesign-vue-next": "^1.10.0",
    "three": ">=0.160.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tdesign-vue-next/auto-import-resolver": "^0.1.2",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^5.4.0",
    "vite-plugin-wasm": "^3.3.0",
    "vue-tsc": "^2.1.10"
  },
  "license": "MIT OR MulanPSL-2.0"
}
