{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svg3dx-studio-copilot",
  "main": "workers/copilot/index.mjs",
  "compatibility_date": "2026-11-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "copilot.dannyxu.net",
      "custom_domain": true
    }
  ],
  "vars": {
    "COPILOT_CORS_ORIGIN": "https://www.dannyxu.net,https://dannyxu.net,https://xiaohunqupo.github.io,http://localhost:5173,http://127.0.0.1:5173"
  }
}
